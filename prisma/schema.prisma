generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now())

  @@map("tb_admin")
}

model Skill {
  id        String   @id @default(uuid())
  category  String   @db.VarChar(50)
  name      String   @db.VarChar(150)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tb_skill")
}

model Experience {
  id          String   @id @default(uuid())
  num         String   @db.VarChar(5)
  period      String   @db.VarChar(50)
  company     String   @db.VarChar(150)
  type        String   @db.VarChar(20)
  role        String   @db.VarChar(150)
  description String   @db.Text
  tags        Json
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tb_experience")
}

model Project {
  id          String   @id @default(uuid())
  num         String   @db.VarChar(5)
  tag         String   @db.VarChar(50)
  tagColor    String?  @db.VarChar(20)
  title       String   @db.VarChar(150)
  description String   @db.Text
  stack       Json
  href        String   @db.VarChar(255)
  featured    Boolean  @default(false)
  filter      String?  @db.VarChar(50)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tb_project")
}

model Service {
  id          String   @id @default(uuid())
  icon        String   @db.VarChar(10)
  title       String   @db.VarChar(150)
  description String   @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tb_service")
}

model ContactLink {
  id        String   @id @default(uuid())
  label     String   @db.VarChar(50)
  href      String   @db.VarChar(255)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tb_contact_link")
}

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique @db.VarChar(200)
  num         String   @db.VarChar(5)
  tag         String   @db.VarChar(50)
  tagColor    String?  @db.VarChar(20)
  title       String   @db.VarChar(200)
  description String   @db.Text
  content     String   @db.LongText
  coverImage  String?  @db.VarChar(500)
  date        String   @db.VarChar(50)
  readTime    String   @db.VarChar(50)
  views       String   @db.VarChar(50)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tb_blog_post")
}
