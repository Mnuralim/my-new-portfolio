generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now())

  @@map("tb_admin")
}

model Skill {
  id        String   @id @default(uuid())
  category  String   @db.VarChar(50)
  name      String   @db.VarChar(150)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tb_skill")
}

model Experience {
  id          String   @id @default(uuid())
  num         String   @db.VarChar(5)
  period      String   @db.VarChar(50)
  company     String   @db.VarChar(150)
  type        String   @db.VarChar(20)
  role        String   @db.VarChar(150)
  description String   @db.Text
  tags        Json
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tb_experience")
}

model Project {
  id          String   @id @default(uuid())
  num         String   @db.VarChar(5)
  tag         String   @db.VarChar(50)
  tagColor    String?  @db.VarChar(20)
  title       String   @db.VarChar(150)
  description String   @db.Text
  stack       Json
  href        String?  @db.VarChar(255)
  featured    Boolean  @default(false)
  filter      String?  @db.VarChar(50)
  coverImage  String?  @db.VarChar(500)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tb_project")
}

model Service {
  id          String   @id @default(uuid())
  icon        String   @db.VarChar(10)
  title       String   @db.VarChar(150)
  description String   @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tb_service")
}

model Credential {
  id        String   @id @default(uuid())
  kind      String   @db.VarChar(20)
  title     String   @db.VarChar(255)
  issuer    String   @db.VarChar(150)
  period    String?  @db.VarChar(50)
  note      String?  @db.VarChar(100)
  url       String?  @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tb_credential")
}

model Cv {
  id        String   @id @default(uuid())
  title     String   @db.VarChar(100)
  fileUrl   String   @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tb_cv")
}

model ContactLink {
  id        String   @id @default(uuid())
  label     String   @db.VarChar(50)
  href      String   @db.VarChar(255)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tb_contact_link")
}

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique @db.VarChar(200)
  num         String   @db.VarChar(5)
  tag         String   @db.VarChar(50)
  tagColor    String?  @db.VarChar(20)
  title       String   @db.VarChar(200)
  description String   @db.Text
  content     String   @db.LongText
  coverImage  String?  @db.VarChar(500)
  date        String   @db.VarChar(50)
  readTime    String   @db.VarChar(50)
  views       String   @db.VarChar(50)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  // incremented with raw SQL so it does not bump updatedAt (sitemap lastmod, JSON-LD dateModified)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  playlists BlogPostPlaylist[]
  comments  Comment[]
  likes     PostLike[]
  viewLog   PostView[]

  @@map("tb_blog_post")
}

model Playlist {
  id          String   @id @default(uuid())
  slug        String   @unique @db.VarChar(200)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  coverImage  String?  @db.VarChar(500)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts BlogPostPlaylist[]

  @@map("tb_playlist")
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique @db.VarChar(150)
  createdAt DateTime @default(now())

  @@map("tb_subscriber")
}

model BlogPostPlaylist {
  blogPostId String
  playlistId String
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@id([blogPostId, playlistId])
  @@map("tb_blog_post_playlist")
}

// reader account created by Google/GitHub sign-in (separate from Admin)
model User {
  id         String   @id @default(uuid())
  provider   String   @db.VarChar(20)
  providerId String   @db.VarChar(100)
  name       String   @db.VarChar(100)
  email      String?  @db.VarChar(150)
  image      String?  @db.VarChar(500)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  comments     Comment[]
  postLikes    PostLike[]
  commentLikes CommentLike[]

  @@unique([provider, providerId])
  @@map("tb_user")
}

model Comment {
  id         String   @id @default(uuid())
  blogPostId String
  userId     String
  // replies are one level deep: a reply to a reply is attached to the top-level comment
  parentId   String?
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  blogPost BlogPost  @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("Replies")
  likes    CommentLike[]

  @@index([blogPostId, createdAt])
  @@index([parentId])
  @@map("tb_comment")
}

model PostLike {
  blogPostId String
  userId     String
  createdAt  DateTime @default(now())

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([blogPostId, userId])
  @@map("tb_post_like")
}

model CommentLike {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@map("tb_comment_like")
}

// one row per visitor per article per day; the unique key is what makes a view count once
model PostView {
  id         String   @id @default(uuid())
  blogPostId String
  visitorId  String   @db.VarChar(36)
  day        String   @db.VarChar(10)
  createdAt  DateTime @default(now())

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, visitorId, day])
  @@map("tb_post_view")
}
